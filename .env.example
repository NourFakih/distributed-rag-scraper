NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/distributed_rag?schema=public
REDIS_URL=redis://localhost:6379
MODEL_CACHE_DIR=.cache/huggingface
EMBEDDING_ALLOW_REMOTE_MODELS=true
EMBEDDING_BATCH_SIZE=16
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=60000
LLM_MAX_OUTPUT_TOKENS=500
RAG_MIN_SIMILARITY=0.75
RAG_MAX_SOURCE_CHARACTERS=1500
RAG_MAX_CONTEXT_CHARACTERS=8000
CRAWLER_USER_AGENT=DistributedRagScraper/0.1 (+https://github.com/NourFakih/distributed-rag-scraper)
CRAWLER_DEFAULT_INTERVAL_MS=1000
CRAWLER_JAVASCRIPT_NAVIGATION_TIMEOUT_MS=15000
CRAWLER_JAVASCRIPT_SETTLE_MS=500
CRAWLER_JAVASCRIPT_WAIT_SELECTOR=
CRAWLER_JAVASCRIPT_WAIT_SELECTOR_TIMEOUT_MS=5000
CRAWLER_JAVASCRIPT_MAX_CONTEXTS=2
LOG_LEVEL=info
