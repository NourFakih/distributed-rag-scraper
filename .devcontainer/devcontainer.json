{
  "name": "Distributed RAG Scraper",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    }
  },
  "postCreateCommand": "bash -lc 'if [ ! -f .env ]; then cp .env.example .env; fi && npm ci && npm run prisma:generate && npx playwright install --with-deps chromium'",
  "forwardPorts": [
    3000,
    4173,
    5173
  ],
  "portsAttributes": {
    "3000": {
      "label": "Express API",
      "onAutoForward": "notify"
    },
    "4173": {
      "label": "Web dashboard (Compose)",
      "onAutoForward": "openBrowser"
    },
    "5173": {
      "label": "Web dashboard (Vite)",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "node"
}
