generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CrawlStatus {
  QUEUED
  PROCESSING
  RETRYING
  COMPLETED
  FAILED
}

enum CrawlPageStatus {
  DISCOVERED
  QUEUED
  PROCESSING
  RETRYING
  COMPLETED
  SKIPPED
  SKIPPED_ROBOTS
  FAILED
}

enum RenderMode {
  STATIC
  JAVASCRIPT
}

model Crawl {
  id               String      @id @default(uuid()) @db.Uuid
  seedUrl          String      @map("seed_url") @db.VarChar(2048)
  normalizedOrigin String      @map("normalized_origin") @db.VarChar(2048)
  renderMode       RenderMode  @default(STATIC) @map("render_mode")
  status           CrawlStatus @default(QUEUED)
  maxPages         Int         @default(25) @map("max_pages")
  maxDepth         Int         @default(2) @map("max_depth")
  discoveredCount  Int         @default(1) @map("discovered_count")
  completedCount   Int         @default(0) @map("completed_count")
  skippedCount     Int         @default(0) @map("skipped_count")
  failedCount      Int         @default(0) @map("failed_count")
  completedAt      DateTime?   @map("completed_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  pages            CrawlPage[]
  deadLetters      DeadLetter[]

  @@index([status])
  @@map("crawls")
}

model CrawlPage {
  id              String          @id @default(uuid()) @db.Uuid
  crawlId         String          @map("crawl_id") @db.Uuid
  url             String          @db.VarChar(2048)
  normalizedUrl   String          @map("normalized_url") @db.VarChar(2048)
  depth           Int
  parentPageId    String?         @map("parent_page_id") @db.Uuid
  status          CrawlPageStatus @default(DISCOVERED)
  attempts        Int             @default(0)
  error           String?         @db.Text
  failureCategory String?         @map("failure_category") @db.VarChar(64)
  createdAt       DateTime        @default(now()) @map("created_at")
  startedAt       DateTime?       @map("started_at")
  completedAt     DateTime?       @map("completed_at")
  crawl           Crawl           @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  parentPage      CrawlPage?      @relation("CrawlPageChildren", fields: [parentPageId], references: [id], onDelete: SetNull)
  childPages      CrawlPage[]     @relation("CrawlPageChildren")
  document        Document?
  deadLetter      DeadLetter?

  @@unique([crawlId, normalizedUrl])
  @@index([crawlId, status])
  @@index([parentPageId])
  @@map("crawl_pages")
}

model DeadLetter {
  id              String    @id @default(uuid()) @db.Uuid
  crawlId         String    @map("crawl_id") @db.Uuid
  crawlPageId     String    @unique @map("crawl_page_id") @db.Uuid
  jobId           String    @map("job_id") @db.VarChar(255)
  url             String    @db.VarChar(2048)
  jobPayload      String    @map("job_payload") @db.Text
  failureCategory String    @map("failure_category") @db.VarChar(64)
  errorMessage    String    @map("error_message") @db.Text
  attemptCount    Int       @map("attempt_count")
  failedAt        DateTime  @default(now()) @map("failed_at")
  crawl           Crawl     @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  crawlPage       CrawlPage @relation(fields: [crawlPageId], references: [id], onDelete: Cascade)

  @@index([crawlId, failedAt])
  @@map("dead_letters")
}

model Document {
  id          String    @id @default(uuid()) @db.Uuid
  crawlPageId String    @unique @map("crawl_page_id") @db.Uuid
  url         String    @db.VarChar(2048)
  title       String?   @db.Text
  rawHtml     String    @map("raw_html") @db.Text
  content     String    @db.Text
  contentHash String    @map("content_hash") @db.Char(64)
  httpStatus  Int       @map("http_status")
  contentType String?   @map("content_type") @db.VarChar(255)
  fetchedAt   DateTime  @default(now()) @map("fetched_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  crawlPage   CrawlPage @relation(fields: [crawlPageId], references: [id], onDelete: Cascade)

  @@index([contentHash])
  @@map("documents")
}
